{
  "name": "@dtc/packaging-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Parametric dieline/geometry generation, print zone placement, and DXF export for packaging (boxes, pouches).",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./shared": "./dist/shared/index.js",
    "./box-styles": "./dist/box-styles/index.js",
    "./pouch-styles": "./dist/pouch-styles/index.js",
    "./placement": "./dist/placement/index.js",
    "./export": "./dist/export/index.js"
  },
  "typesVersions": {
    "*": {
      "shared": ["dist/shared/index.d.ts"],
      "box-styles": ["dist/box-styles/index.d.ts"],
      "pouch-styles": ["dist/pouch-styles/index.d.ts"],
      "placement": ["dist/placement/index.d.ts"],
      "export": ["dist/export/index.d.ts"]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "jest",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@tarikjabiri/dxf": "^2.8.9"
  },
  "devDependencies": {
    "@swc/core": "^1.5.7",
    "@swc/jest": "^0.2.36",
    "@types/jest": "^29.5.13",
    "@types/node": "^20.12.11",
    "jest": "^29.7.0",
    "typescript": "^5.4.5"
  }
}
